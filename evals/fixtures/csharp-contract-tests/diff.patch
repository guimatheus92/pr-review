+using Microsoft.VisualStudio.TestTools.UnitTesting;
+using System.Reflection;
+using Contoso.Api;
+
+namespace Contoso.Api.Tests;
+
+[TestClass]
+public sealed class WorkspaceControllerContractTests
+{
+    [TestMethod]
+    public void Get_WhenEndpointDeclared_MatchesCurrentMetadata()
+    {
+        var action = typeof(WorkspaceController).GetMethod(nameof(WorkspaceController.Get));
+        Assert.IsNotNull(action);
+
+        var authorization = action.GetCustomAttribute<PartnerApiAuthorizationAttribute>();
+        Assert.IsNotNull(authorization);
+
+        var routeFilter = action.GetCustomAttribute<RouteFilterAttribute>();
+        Assert.IsNotNull(routeFilter);
+
+        var expectedFilterArgument = action.GetParameters()[0].Name;
+        Assert.AreEqual(expectedFilterArgument, routeFilter.ArgumentName);
+    }
+}