{
  "name": "pr-review",
  "version": "0.15.1",
  "description": "Generic, plugin-based PR review for GitHub, Azure DevOps, and GitLab. Reviews with parallel passes built from synced skill packs (stack-aware, zero built-in reviewers) in a single session (Copilot CLI or Claude Code), with optional Codex second opinion.",
  "private": true,
  "type": "module",
  "bin": {
    "pr-review": "./bin/pr-review"
  },
  "scripts": {
    "build": "tsc && npm run bundle",
    "build:watch": "tsc --watch",
    "bundle": "node scripts/bundle.mjs",
    "dogfood": "node scripts/dogfood.mjs",
    "acceptance": "node scripts/acceptance.mjs",
    "acceptance:seed": "node scripts/acceptance-seed.mjs",
    "test": "node scripts/test.mjs",
    "clean": "rimraf dist",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "azure-devops-node-api": "^17.0.1",
    "commander": "^12.1.0",
    "jsonc-parser": "^3.3.1",
    "p-limit": "^7.3.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "esbuild": "^0.24.2",
    "rimraf": "^6.0.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3"
  }
}
